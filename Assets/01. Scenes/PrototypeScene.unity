  m_Script: {fileID: 11500000, guid: 5d890a165a7761344bffc3dc031a952d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AbilityDescriptionUI
  panel: {fileID: 497731969}
  text: {fileID: 1787044960}
  descriptions:
  - "\uAE30\uBCF8\uC801\uC778 \uC0C1\uD0DC\uC785\uB2C8\uB2E4."
  - "\uBC14\uB77C\uBCF4\uB294 \uBC29\uD5A5\uC73C\uB85C \uC801\uC744 \uC8FD\uC774\uAC70\uB098
    \uD2B9\uC815 \uC7A5\uC560\uBB3C\uC744 \uBD80\uC220 \uC218 \uC788\uACE0 \uC2A4\uC704\uCE58\uB97C
    \uB204\uB97C \uC218 \uC788\uB294 \uD654\uC0B4\uC744 \uBC1C\uC0AC\uD569\uB2C8\uB2E4."
  - "\uC810\uD504\uC640 \uB300\uC26C\uB97C \uD560 \uC218 \uC5C6\uACE0 \uC774\uB3D9
    \uC18D\uB3C4\uAC00 \uB290\uB824\uC9C0\uC9C0\uB9CC \uC678\uD615\uC774 \uC791\uC544\uC9D1\uB2C8\uB2E4."
  - "\uC810\uD504\uC640 \uB300\uC26C\uB97C \uD560 \uC218 \uC5C6\uACE0 \uC774\uB3D9
    \uC18D\uB3C4\uAC00 \uB290\uB824\uC9C0\uC9C0\uB9CC \uBC14\uB2E5 \uC7A5\uC560\uBB3C\uC5D0\uAC8C
    \uD53C\uD574\uB97C \uC785\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4."
  - "\uC0C1\uC2DC \uB2A5\uB825\uC774 \uBC1C\uB3D9\uB429\uB2C8\uB2E4. \uD2B9\uC815
    \uC7A5\uC560\uBB3C\uACFC \uC0C1\uD638\uC791\uC6A9 \uD560 \uC218 \uC788\uACE0
    \uB300\uC26C \uAC70\uB9AC\uAC00 10%, \uC810\uD504 \uB192\uC774\uAC00 100% \uC99D\uAC00\uD569\uB2C8\uB2E4."
